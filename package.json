{
  "name": "codefactory-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "pnpm db:generate",
    "build": "next build",
    "prebuild": "pnpm db:generate",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "cross-env NODE_ENV=development prisma migrate deploy",
    "db:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev",
    "db:migrate:reset": "cross-env NODE_ENV=development prisma migrate reset",
    "db:studio": "cross-env NODE_ENV=development prisma studio",
    "lint": "eslint --cache --max-warnings 0 --no-warn-ignored .",
    "lint:fix": "eslint --cache --max-warnings 0 --no-warn-ignored --fix .",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv-load": "^3.0.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{html,css,json,md,yml,yaml}": "prettier --check --ignore-unknown",
    "*.{ts,mts,cts,tsx,js,mjs,cjs,jsx}": [
      "eslint --cache --max-warnings 0 --no-warn-ignored",
      "prettier --check --ignore-unknown"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
