{
  "name": "codefactory-studio",
  "version": "0.1.0-rc.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "pnpm db:generate",
    "build": "next build",
    "prebuild": "pnpm db:generate",
    "start": "next start",
    "test": "vitest --passWithNoTests",
    "pretest": "pnpm db:generate",
    "cypress:open": "cross-env NODE_ENV=test start-server-and-test 'pnpm dev' http://localhost:3000 'cypress open --e2e'",
    "precypress:open": "pnpm db:generate",
    "cypress:run": "cross-env NODE_ENV=test start-server-and-test 'pnpm dev' http://localhost:3000 'cypress run --e2e --pass-with-no-tests'",
    "precypress:run": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "cross-env NODE_ENV=development prisma migrate deploy",
    "db:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev",
    "db:migrate:reset": "cross-env NODE_ENV=development prisma migrate reset",
    "db:studio": "cross-env NODE_ENV=development prisma studio",
    "github:webhook:proxy": "node scripts/github-webhook-proxy.js",
    "lint": "eslint --cache --max-warnings 0 --no-warn-ignored .",
    "lint:fix": "eslint --cache --max-warnings 0 --no-warn-ignored --fix .",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "publish-packages": "pnpm lint && pnpm format && pnpm test && pnpm cypress:run && pnpm build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/i18n": "^1.7.7",
    "@better-auth/prisma-adapter": "^1.7.7",
    "@hookform/resolvers": "^5.9.1",
    "@octokit/types": "^18.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv-load": "^3.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.4",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "smee-client": "^5.0.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{html,css,json,md,yml,yaml}": "prettier --check --ignore-unknown",
    "*.{ts,mts,cts,tsx,js,mjs,cjs,jsx}": [
      "eslint --cache --max-warnings 0 --no-warn-ignored",
      "prettier --check --ignore-unknown"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
