# Postgres Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Better-Auth Secret
BETTER_AUTH_SECRET="your-secret-here"
# Better-Auth URL
BETTER_AUTH_URL="http://localhost:3000"

# GitHub App App ID
GITHUB_APP_APPID="your-app-id-here"
# GitHub App Private Key
GITHUB_APP_PRIVATE_KEY="your-private-key-here"
# GitHub App Client ID
GITHUB_APP_CLIENT_ID="your-client-id-here"
# GitHub App Client Secret
GITHUB_APP_CLIENT_SECRET="your-client-secret-here"
# GitHub App Webhook Secret
GITHUB_APP_WEBHOOK_SECRET="your-webhook-secret-here"
